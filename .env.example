# ==============================================================================
# ComfyUI Blackwell Bundle Environment Configuration (.env)
# Copy this file to .env and adjust variables to suit your local setup.
# ==============================================================================

# Network Port and Host Binding
# Bind to 127.0.0.1 for local-only access, or 0.0.0.0 for LAN access
COMFYUI_PORT=8188
COMFYUI_BIND_IP=0.0.0.0

# Smart ComfyUI Gallery Companion Port and Host Binding
SMARTGALLERY_PORT=8189
SMARTGALLERY_BIND_IP=0.0.0.0

# User & Group ID Mapping (match your host user UID/GID with `id -u` / `id -g`)
PUID=1000
PGID=1000
UMASK=0022

# Shared Memory Allocation
# 16gb is recommended to avoid bus errors during high-resolution multi-frame video decoding
SHM_SIZE=16gb

# VRAM Headroom Buffer (in GB) reserved for desktop environments & external tasks
RESERVE_VRAM=1.5

# ComfyUI GPU Memory Flags
# For RTX 5090 (32GB): --preview-method auto
# For RTX 5080 (16GB): --preview-method auto --normalvram
COMFYUI_FLAGS=--preview-method auto

# Custom Model / Output / Input Storage Paths
# Default: Relative paths to repository ./data subdirectories.
# Secondary Drive / WSL2 Tier 2 NVMe setup:
#   COMFYUI_MODELS_PATH=/path/to/external/models
#   COMFYUI_OUTPUT_PATH=/path/to/external/output
#   COMFYUI_INPUT_PATH=/path/to/external/input
COMFYUI_MODELS_PATH=./data/models
COMFYUI_OUTPUT_PATH=./data/output
COMFYUI_INPUT_PATH=./data/input
COMFYUI_WORKFLOWS_PATH=./workflows

# Default Generic Workflow & Model Alias Configuration
# Set COMFYUI_DEFAULT_WORKFLOW to any workflow JSON path to override the initial canvas
COMFYUI_DEFAULT_WORKFLOW=./default_workflow.json

# Model Alias: Set to 'none' to disable automatic symlink creation
DEFAULT_CHECKPOINT_ALIAS=DreamShaper_8_pruned.safetensors
DEFAULT_CHECKPOINT_NAME=v1-5-pruned-emaonly.safetensors
